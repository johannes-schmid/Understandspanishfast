  "questions": [
    {
      "q": "¿Por qué Pablo quería hacer algo bonito este año?",
      "a": "Porque el año pasado olvidó el día de Paula.",
      "q_en": "Why did Pablo want to do something nice this year?",
      "a_en": "Because last year he forgot Paula's special day."
    },
    {
      "q": "¿Por qué Pablo puso el fuego muy alto?",
      "a": "Porque quería terminar más rápido.",
      "q_en": "Why did Pablo turn the heat up very high?",
      "a_en": "Because he wanted to finish faster."
    },
    {
      "q": "¿Qué hicieron padre e hijo mientras esperaban?",
      "a": "Vieron una película y se quedaron dormidos.",
      "q_en": "What did father and son do while they were waiting?",
      "a_en": "They watched a movie and fell asleep."
    },
    {
      "q": "¿Qué hizo Toby?",
      "a": "Tomó la comida con la boca y salió corriendo a la calle.",
      "q_en": "What did Toby do?",
      "a_en": "He took the food in his mouth and ran out to the street."
    },
    {
      "q": "¿Quién preparó la comida al final?",
      "a": "Paula, la madre.",
      "q_en": "Who made the food in the end?",
      "a_en": "Paula, the mother."
    }
  ],
