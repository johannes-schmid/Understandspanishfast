      "lemma": "flor",
      "en": "flowers"
    }
  ],
  "questions": [
    {
      "q": "¿Por qué cuida Pilar las flores?",
      "a": "Porque eran de Antonio, y es una manera de estar con él.",
      "q_en": "Why does Pilar look after the flowers?",
      "a_en": "Because they were Antonio's, and it is a way of being with him."
    },
    {
      "q": "¿Qué hizo Pilar cuando el perro entró la primera vez?",
      "a": "Le dijo con voz fuerte: «¡Fuera de aquí!».",
      "q_en": "What did Pilar do when the dog came in the first time?",
      "a_en": "She told it loudly: \"Get out of here!\""
    },
    {
      "q": "¿Qué nombre le puso Pilar al perro?",
      "a": "Le puso Rey.",
      "q_en": "What name did Pilar give the dog?",
      "a_en": "She called it Rey (King)."
    },
    {
      "q": "¿Por qué no llegó el perro un día?",
      "a": "Porque comió algo malo en la calle y estaba enfermo.",
      "q_en": "Why didn't the dog come one day?",
      "a_en": "Because it ate something bad in the street and was sick."
    },
    {
      "q": "¿Qué le pidió Clara a Pilar?",
      "a": "Le pidió cuidar a Rey cuando ellos trabajan.",
      "q_en": "What did Clara ask Pilar?",
      "a_en": "She asked her to look after Rey while they are at work."
    }
  ],
