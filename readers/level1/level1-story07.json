  "questions": [
    {
      "q": "¿Cuándo llegaban Julio y Teresa?",
      "a": "Cada semana, a las 9 de la noche.",
      "q_en": "When did Julio and Teresa arrive?",
      "a_en": "Every week, at 9 at night."
    },
    {
      "q": "¿Qué pedían siempre?",
      "a": "Lo de siempre y vino blanco.",
      "q_en": "What did they always order?",
      "a_en": "The usual and white wine."
    },
    {
      "q": "¿Por qué llegó Julio solo?",
      "a": "Porque Teresa murió hace tres semanas.",
      "q_en": "Why did Julio arrive alone?",
      "a_en": "Because Teresa died three weeks ago."
    },
    {
      "q": "¿Qué le prometió Julio a Teresa?",
      "a": "Volver cada semana y no quedarse solo en casa.",
      "q_en": "What did Julio promise Teresa?",
      "a_en": "To keep coming back every week and not stay home alone."
    },
    {
      "q": "¿Qué le pregunta Julio a Ramón una noche?",
      "a": "Si ya tiene novia.",
      "q_en": "What does Julio ask Ramón one night?",
      "a_en": "Whether he has a girlfriend yet."
    }
  ],
