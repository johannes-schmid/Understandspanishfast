  "questions": [
    {
      "q": "¿Qué compraba Cristina cada mañana?",
      "a": "Un pan y dos galletas.",
      "q_en": "What did Cristina buy every morning?",
      "a_en": "A loaf of bread and two cookies."
    },
    {
      "q": "¿Por qué pensaba Rafael que Cristina venía cada día?",
      "a": "Pensaba que venía a estudiar sus precios y su pan.",
      "q_en": "Why did Rafael think Cristina came every day?",
      "a_en": "He thought she came to study his prices and his bread."
    },
    {
      "q": "¿Qué querían los jefes de Cristina?",
      "a": "Querían bajar mucho el precio del pan hasta que Rafael cerrara.",
      "q_en": "What did Cristina's bosses want?",
      "a_en": "They wanted to lower the price of bread a lot until Rafael closed."
    },
    {
      "q": "¿Por qué le gustaba a Cristina el pan de Rafael?",
      "a": "Porque olía como el pan de su abuela.",
      "q_en": "Why did Cristina like Rafael's bread?",
      "a_en": "Because it smelled like her grandmother's bread."
    },
    {
      "q": "¿Qué le pidió Rafael a Cristina al final?",
      "a": "Que viniera a las cinco para ayudarlo con el pan.",
      "q_en": "What did Rafael ask Cristina at the end?",
      "a_en": "To come at five to help him with the bread."
    }
  ],
