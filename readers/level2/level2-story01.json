  "questions": [
    {
      "q": "¿Qué encontró Silvia en el armario de su madre?",
      "a": "Una caja con papeles de otra cuenta en otro banco.",
      "q_en": "What did Silvia find in her mother's closet?",
      "a_en": "A box with papers for another account at another bank."
    },
    {
      "q": "¿Qué hizo el padre de Fernando hace treinta años?",
      "a": "Saltó al río y salvó a Silvia, pero él murió.",
      "q_en": "What did Fernando's father do thirty years ago?",
      "a_en": "He jumped into the river and saved Silvia, but he died."
    },
    {
      "q": "¿Qué le prometió la madre de Silvia a la madre de Fernando?",
      "a": "Que a Fernando nunca le iba a faltar nada.",
      "q_en": "What did Silvia's mother promise Fernando's mother?",
      "a_en": "That Fernando would never lack anything."
    },
    {
      "q": "¿Por qué la madre de Silvia nunca le contó nada?",
      "a": "Porque no quería que su hija creciera con ese peso.",
      "q_en": "Why did Silvia's mother never tell her anything?",
      "a_en": "Because she didn't want her daughter to grow up carrying that weight."
    },
    {
      "q": "¿Qué quiere Silvia que Fernando haga con el dinero guardado?",
      "a": "Quiere que lo guarde para su hija y su universidad.",
      "q_en": "What does Silvia want Fernando to do with the saved money?",
      "a_en": "She wants him to keep it for his daughter and her university studies."
    }
  ],
