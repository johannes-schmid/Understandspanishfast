  "questions": [
    {
      "q": "¿Qué le pidió la mujer a Andrés cuando subió al carro?",
      "a": "Que manejara a cualquier lugar.",
      "q_en": "What did the woman ask Andrés when she got into the car?",
      "a_en": "To drive anywhere."
    },
    {
      "q": "¿Qué pensaba Andrés de la voz de Lola?",
      "a": "Que cantaba como un gato con dolor de estómago.",
      "q_en": "What did Andrés think of Lola's voice?",
      "a_en": "That she sang like a cat with a stomachache."
    },
    {
      "q": "¿Por qué Andrés no quería oír las canciones de Lola?",
      "a": "Porque le recordaban a su esposa muerta, que las cantaba en la cocina.",
      "q_en": "Why didn't Andrés want to hear Lola's songs?",
      "a_en": "Because they reminded him of his late wife, who sang them in the kitchen."
    },
    {
      "q": "¿Qué hicieron Andrés y Lola cerca de la iglesia vieja?",
      "a": "Comieron sopa y pan con queso en el carro.",
      "q_en": "What did Andrés and Lola do near the old church?",
      "a_en": "They ate soup and bread with cheese in the car."
    },
    {
      "q": "¿Qué escribió Lola en el papel?",
      "a": "Su teléfono y que le daba dos asientos en primera fila para su próximo espectáculo.",
      "q_en": "What did Lola write on the paper?",
      "a_en": "Her phone number and that she was giving him two front-row seats for her next show."
    }
  ],
