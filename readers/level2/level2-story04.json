  "questions": [
    {
      "q": "¿Qué mentira dijo Gonzalo en su entrevista de trabajo?",
      "a": "Dijo que hablaba inglés muy bien, como un inglés.",
      "q_en": "What lie did Gonzalo tell in his job interview?",
      "a_en": "He said he spoke English very well, like an Englishman."
    },
    {
      "q": "¿Qué hizo Gonzalo para aprender inglés en pocos días?",
      "a": "Compró libros, puso películas en inglés, escuchó una canción muchas veces y le habló en inglés a su gato.",
      "q_en": "What did Gonzalo do to learn English in a few days?",
      "a_en": "He bought books, watched movies in English, listened to a song many times and spoke English to his cat."
    },
    {
      "q": "¿Qué hacía Gonzalo en la reunión cuando no entendía?",
      "a": "Decía que sí con la cabeza y respondía que sí a todo.",
      "q_en": "What did Gonzalo do in the meeting when he didn't understand?",
      "a_en": "He nodded and answered yes to everything."
    },
    {
      "q": "¿Cómo sabía Mercedes que Gonzalo no hablaba inglés?",
      "a": "Porque en la entrevista le preguntó su edad en inglés y él respondió que sí.",
      "q_en": "How did Mercedes know that Gonzalo didn't speak English?",
      "a_en": "Because in the interview she asked him his age in English and he answered yes."
    },
    {
      "q": "¿Qué mentira dijo Mercedes hace veinte años?",
      "a": "Dijo que hablaba francés, pero no es verdad.",
      "q_en": "What lie did Mercedes tell twenty years ago?",
      "a_en": "She said she spoke French, but it isn't true."
    }
  ],
