  "questions": [
    {
      "q": "¿Por qué tenía prisa Sergio?",
      "a": "Porque tenía un juicio en Barcelona a las nueve de la mañana.",
      "q_en": "Why was Sergio in a hurry?",
      "a_en": "Because he had a trial in Barcelona at nine in the morning."
    },
    {
      "q": "¿Cómo manejaba Sergio?",
      "a": "Despacio, con las dos manos, y nunca pasaba de cien kilómetros por hora.",
      "q_en": "How did Sergio drive?",
      "a_en": "Slowly, with both hands, and he never went over one hundred kilometers per hour."
    },
    {
      "q": "¿Qué encontraron en el medio del camino oscuro?",
      "a": "Una vaca.",
      "q_en": "What did they find in the middle of the dark road?",
      "a_en": "A cow."
    },
    {
      "q": "¿Qué va a hacer Inés si no vende ninguna pintura?",
      "a": "Va a trabajar en el banco de su tío.",
      "q_en": "What will Inés do if she doesn't sell any painting?",
      "a_en": "She will work at her uncle's bank."
    },
    {
      "q": "¿Qué le dio Inés a Sergio delante del tribunal?",
      "a": "Un dibujo de él dormido en el carro, con la dirección de la sala detrás.",
      "q_en": "What did Inés give Sergio in front of the courthouse?",
      "a_en": "A drawing of him asleep in the car, with the address of the gallery room on the back."
    }
